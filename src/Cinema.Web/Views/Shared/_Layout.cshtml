<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Storyline Cinema | Rạp Chiếu Phim Hiện Đại</title>
    
    <!-- Google Font Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Storyline Cinema Customer Dark Theme CSS -->
    <link rel="stylesheet" href="~/css/cinema-customer.css" asp-append-version="true" />
</head>
<body>
    <!-- ==================================================================== -->
    <!-- TOP NAVBAR (HỖ TRỢ CẢ GIAO DIỆN TRƯỚC VÀ SAU ĐĂNG NHẬP) -->
    <!-- ==================================================================== -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-xl cinema-navbar py-2">
            <div class="container-xl">
                <!-- Brand Logo Storyline Cinema Gốc -->
                <a class="brand-badge" href="/">
                    <img src="~/images/storyline_logo.png" alt="Storyline Cinema" class="brand-logo-img" />
                    <div>
                        <div class="brand-title">STORYLINE</div>
                        <div class="brand-subtitle">CINEMA</div>
                    </div>
                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler text-light border-0" type="button" data-bs-toggle="collapse" data-bs-target="#cinemaNavContent">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>

                <!-- Navigation Links & User Controls -->
                <div class="collapse navbar-collapse" id="cinemaNavContent">
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0 ms-xl-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link cinema-nav-link active" href="#moviesSection">
                                <i class="bi bi-film me-1"></i> Phim Chiếu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cinema-nav-link" href="#showtimesSection">
                                <i class="bi bi-calendar3 me-1"></i> Lịch Chiếu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cinema-nav-link" href="#pricingSection">
                                <i class="bi bi-tag me-1"></i> Bảng Giá Vé
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cinema-nav-link" href="#promotionsSection">
                                <i class="bi bi-gift me-1"></i> Ưu Đãi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cinema-nav-link" href="#ticketLookupSection">
                                <i class="bi bi-search me-1"></i> Tra Cứu Vé
                            </a>
                        </li>
                    </ul>

                    <!-- Right Controls: Hotline, Demo Role Switcher & Auth Section -->
                    <div class="d-flex align-items-center flex-wrap gap-2 pt-2 pt-xl-0">
                        <!-- Hotline Badge -->
                        <div class="cinema-hotline-box d-none d-md-flex">
                            <i class="bi bi-telephone-fill text-warning"></i>
                            <span>1900 8888</span>
                        </div>

                        <!-- CÔNG TẮC DEMO: Khách vãng lai <-> Hội viên đã đăng nhập -->
                        <button type="button" class="demo-role-badge btn-sm" id="btnToggleDemoRole" title="Nhấn để chuyển đổi nhanh giữa Giao diện Khách chưa đăng nhập và Khách đã đăng nhập">
                            <i class="bi bi-arrow-left-right me-1"></i>
                            <span id="demoRoleText">Demo: Khách Vãng Lai</span>
                        </button>

                        <!-- KHU VỰC TRƯỚC ĐĂNG NHẬP (PRE-LOGIN: KHÁCH VÃNG LAI) -->
                        <div id="preLoginAuthArea" class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-cinema-outline btn-sm px-3" data-bs-toggle="modal" data-bs-target="#registerModal">
                                <i class="bi bi-person-plus me-1"></i> Đăng Ký
                            </button>
                            <button type="button" class="btn btn-cinema-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#loginModal">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                            </button>
                        </div>

                        <!-- KHU VỰC SAU ĐĂNG NHẬP (POST-LOGIN: HỘI VIÊN STORYLINE) -->
                        <div id="postLoginAuthArea" class="d-none">
                            <div class="dropdown">
                                <button class="user-profile-badge border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar-circle">AN</div>
                                    <div class="text-start d-none d-sm-block pe-1">
                                        <div class="fw-bold text-white small lh-1">Nguyễn Văn An</div>
                                        <div class="text-warning fw-bold" style="font-size: 0.68rem;">⭐ Hội Viên Vàng</div>
                                    </div>
                                    <span class="badge bg-warning text-dark fw-bold rounded-pill" style="font-size: 0.7rem;">250 Điểm</span>
                                    <i class="bi bi-chevron-down text-secondary small"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg" style="background: #1e293b; border-color: #334155; min-width: 230px;">
                                    <li class="px-3 py-2 border-bottom border-secondary">
                                        <div class="fw-bold text-white">Nguyễn Văn An</div>
                                        <div class="small text-secondary">0912 345 678 • Gold Member</div>
                                        <div class="text-warning small fw-bold mt-1">Điểm tích lũy: 250 Điểm (250.000đ)</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="javascript:void(0)" onclick="openCustomerDashboard('overview')">
                                            <i class="bi bi-speedometer2 text-primary me-2"></i> Dashboard Thành Viên
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="javascript:void(0)" onclick="openCustomerDashboard('myTickets')">
                                            <i class="bi bi-ticket-perforated text-success me-2"></i> Vé Của Tôi <span class="badge bg-danger ms-1">1 Vé mới</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="javascript:void(0)" onclick="openCustomerDashboard('rewards')">
                                            <i class="bi bi-gift text-warning me-2"></i> Đổi Điểm Thưởng & Voucher
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-secondary my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" href="javascript:void(0)" id="btnLogoutUser">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng Xuất (Về Khách Vãng Lai)
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- ==================================================================== -->
    <!-- MAIN CONTENT BODY -->
    <!-- ==================================================================== -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ==================================================================== -->
    <!-- FOOTER CHUẨN THƯƠNG HIỆU STORYLINE CINEMA -->
    <!-- ==================================================================== -->
    <footer class="cinema-footer">
        <div class="container-xl">
            <div class="row g-4">
                <!-- Col 1: Thương hiệu & Địa chỉ -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/storyline_logo.png" alt="Storyline Logo" style="width: 42px; height: 42px;" />
                        <div>
                            <span class="fs-5 fw-bold text-white">STORYLINE CINEMA</span>
                            <div class="small text-warning fw-bold" style="letter-spacing: 2px;">RẠP CHIẾU PHIM HIỆN ĐẠI</div>
                        </div>
                    </div>
                    <p class="small text-secondary mb-3">
                        Cụm rạp chiếu phim chất lượng cao tiêu chuẩn quốc tế. Hệ thống trình chiếu Laser 4K đỉnh cao kết hợp âm thanh vòm Dolby Atmos đa chiều mang lại trải nghiệm điện ảnh trọn vẹn.
                    </p>
                    <div class="small text-light mb-1"><i class="bi bi-geo-alt-fill text-danger me-2"></i>123 Đường Điện Biên Phủ, P.15, Q. Bình Thạnh, TP.HCM</div>
                    <div class="small text-light mb-1"><i class="bi bi-telephone-fill text-warning me-2"></i>Hotline: 1900 8888 (08:00 - 24:00)</div>
                    <div class="small text-light"><i class="bi bi-envelope-fill text-primary me-2"></i>cskh@storylinecinema.vn</div>
                </div>

                <!-- Col 2: Phim & Lịch chiếu -->
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="footer-heading">Phim & Lịch Chiếu</h6>
                    <ul class="footer-link-list">
                        <li><a href="#moviesSection">Phim đang chiếu hôm nay</a></li>
                        <li><a href="#moviesSection">Phim sắp chiếu bom tấn</a></li>
                        <li><a href="#showtimesSection">Lịch chiếu theo ngày</a></li>
                        <li><a href="#pricingSection">Bảng giá vé 2D / 3D / IMAX</a></li>
                        <li><a href="#ticketLookupSection">Tra cứu mã vé nhanh</a></li>
                    </ul>
                </div>

                <!-- Col 3: Hội viên & Tích điểm -->
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="footer-heading">Hội Viên & Điểm</h6>
                    <ul class="footer-link-list">
                        <li><a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#registerModal">Đăng ký thành viên mới</a></li>
                        <li><a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#loginModal">Đăng nhập tài khoản hội viên</a></li>
                        <li><a href="#pricingSection">Quyền lợi tích điểm 5% - 10%</a></li>
                        <li><a href="#promotionsSection">Đổi điểm lấy vé xem phim</a></li>
                        <li><a href="#promotionsSection">Quà tặng sinh nhật thành viên</a></li>
                    </ul>
                </div>

                <!-- Col 4: Cơ sở vật chất -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-heading">Cơ Sở Vật Chất</h6>
                    <ul class="footer-link-list">
                        <li><span class="text-secondary">• 06 Phòng chiếu Laser 4K</span></li>
                        <li><span class="text-secondary">• Âm thanh Dolby Atmos 7.1</span></li>
                        <li><span class="text-secondary">• Ghế VIP Prime & Sweetbox đôi</span></li>
                        <li><span class="text-secondary">• Quầy bắp nước Fast-Track</span></li>
                        <li><span class="text-secondary">• Bãi giữ xe máy & ô tô miễn phí</span></li>
                    </ul>
                </div>

                <!-- Col 5: Quy định & Chính sách -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-heading">Chính Sách & Hỗ Trợ</h6>
                    <ul class="footer-link-list">
                        <li><span class="text-secondary">• Hủy vé hoàn tiền trước 60p</span></li>
                        <li><span class="text-secondary">• Quy định phân loại độ tuổi P, C13, C16, C18</span></li>
                        <li><span class="text-secondary">• Hướng dẫn thanh toán VietQR</span></li>
                        <li><span class="text-secondary">• Soát vé nhanh qua mã QR</span></li>
                        <li><span class="text-secondary">• Điều khoản bảo mật thông tin</span></li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-secondary">
                <div>© 2026 Storyline Cinema System. Hệ thống đặt vé trực tuyến & quản trị rạp chiếu phim (BTL LTTQ).</div>
                <div class="d-flex gap-3">
                    <span class="badge bg-secondary">C# .NET 10.0</span>
                    <span class="badge bg-dark border border-secondary">Single Cinema Architecture</span>
                    <span class="badge bg-primary">Customer Web Portal</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
