@{
    ViewData["Title"] = "Trang Chủ - Đặt Vé Xem Phim Trực Tuyến";
}

<!-- ======================================================================== -->
<!-- BANNER CHÀO MỪNG HỘI VIÊN (CHỈ HIỂN THỊ KHI Ở CHẾ ĐỘ ĐÃ ĐĂNG NHẬP) -->
<!-- ======================================================================== -->
<div id="postLoginMemberBanner" class="container-xl pt-4 d-none">
    <div class="welcome-member-banner">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">⭐ GOLD MEMBER</span>
                    <span class="text-secondary small">Mã thẻ: SL-882194</span>
                </div>
                <h4 class="text-white fw-bold mb-1">
                    CHÀO MỪNG TRỞ LẠI, <span class="text-warning">NGUYỄN VĂN AN</span>!
                </h4>
                <p class="text-secondary small mb-2">
                    Điểm thưởng hiện có: <strong class="text-warning fs-5">250 Điểm</strong> (Tương đương <strong>250.000 VNĐ</strong>) • Tỉ lệ tích điểm ưu đãi: <strong class="text-success">10% giá trị mỗi đơn vé</strong>.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-warning btn-sm fw-bold px-3" onclick="openCustomerDashboard('rewards')">
                        <i class="bi bi-gift-fill me-1"></i> Đổi 100 Điểm Lấy Vé 2D Miễn Phí
                    </button>
                    <button type="button" class="btn btn-outline-light btn-sm fw-bold px-3" onclick="openCustomerDashboard('overview')">
                        <i class="bi bi-speedometer2 me-1"></i> Xem Dashboard Hội Viên
                    </button>
                </div>
            </div>
            <!-- Thẻ nhắc vé sắp chiếu hôm nay -->
            <div class="col-lg-4">
                <div class="p-3 rounded-3" style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(59, 130, 246, 0.3);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-primary small fw-bold"><i class="bi bi-bell-fill me-1"></i> VÉ SẮP CHIẾU (HÔM NAY)</span>
                        <span class="badge bg-danger">19:30</span>
                    </div>
                    <div class="fw-bold text-white small">Kẻ Trộm Mặt Trăng 4 (2D)</div>
                    <div class="small text-secondary mb-2">Phòng 01 • Ghế: <strong class="text-warning">F06, F07</strong> • Mã: VE882194</div>
                    <button type="button" class="btn btn-cinema-primary btn-sm w-100 py-1 fw-bold" onclick="showTicketDetailModal('VE882194')">
                        <i class="bi bi-qr-code-scan me-1"></i> Mở Mã QR Check-in Vào Rạp
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================================== -->
<!-- HERO SECTION: PHIM BOM TẤN NỔI BẬT NHẤT HÔM NAY -->
<!-- ======================================================================== -->
<section class="cinema-hero-wrapper">
    <div class="container-xl">
        <div class="row align-items-center g-4">
            <!-- Poster phim bom tấn -->
            <div class="col-lg-4 col-md-5 text-center">
                <div class="hero-poster-frame">
                    <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600&auto=format&fit=crop&q=80" 
                         alt="Kẻ Trộm Mặt Trăng 4" class="hero-poster-img" id="heroPosterImg" />
                    <button type="button" class="btn-trailer-float" onclick="openTrailerModal('Kẻ Trộm Mặt Trăng 4')">
                        <i class="bi bi-play-circle-fill me-1 text-danger"></i> Xem Trailer HD
                    </button>
                </div>
            </div>

            <!-- Thông tin chi tiết phim & Nút đặt vé -->
            <div class="col-lg-8 col-md-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-danger text-uppercase fw-bold px-2 py-1" style="font-size: 0.72rem;">● PHIM BOM TẤN ĐANG CHIẾU HÔM NAY</span>
                    <span class="badge badge-age badge-age-c13" id="heroAgeBadge">C13</span>
                    <span class="badge bg-dark border border-secondary text-light small"><i class="bi bi-badge-hd me-1"></i> 2D / 3D Atmos</span>
                    <span class="badge bg-dark border border-secondary text-warning small"><i class="bi bi-star-fill text-warning me-1"></i> 9.2 / 10</span>
                </div>

                <h1 class="display-6 fw-extrabold text-white mb-2" id="heroMovieTitle">
                    KẺ TRỘM MẶT TRĂNG 4 (DESPICABLE ME 4)
                </h1>

                <p class="text-secondary small mb-3">
                    Đạo diễn: <strong>Chris Renaud</strong> • Diễn viên: <strong>Steve Carell, Kristen Wiig, Will Ferrell</strong><br>
                    Thể loại: <strong>Hoạt hình, Hài hước, Phiêu lưu gia đình</strong> • Thời lượng: <strong>95 Phút</strong> • Ngôn ngữ: <strong>Lồng tiếng & Phụ đề</strong>
                </p>

                <p class="text-light mb-3" style="max-width: 650px; font-size: 0.95rem; line-height: 1.6;">
                    Gru cùng đại gia đình đón chào quý tử Gru Jr. nhưng bị đảo lộn khi Maxime Le Mal trốn ngục quyết tâm trả thù. Cả gia đình phải chuyển tới thị trấn mới dưới thân phận bí mật cùng nhóm Minions siêu năng lực Mega Minions!
                </p>

                <!-- Box tình trạng phòng chiếu -->
                <div class="d-inline-flex align-items-center gap-3 p-2 px-3 rounded-3 mb-4" style="background: rgba(30, 41, 59, 0.7); border: 1px solid var(--cinema-border);">
                    <div class="small text-secondary">
                        <i class="bi bi-door-open-fill text-primary me-1"></i> Suất kế tiếp: <strong class="text-white">19:30</strong> (Phòng 01 - Tiêu chuẩn 2D)
                    </div>
                    <div class="vr bg-secondary"></div>
                    <div class="small text-success fw-bold">
                        <i class="bi bi-check-circle-fill me-1"></i> Còn 82 / 140 ghế trống
                    </div>
                </div>

                <!-- Call to action buttons -->
                <div class="d-flex flex-wrap gap-3">
                    <button type="button" class="btn btn-cinema-danger btn-lg px-4 fs-6" onclick="startBookingFlow('Kẻ Trộm Mặt Trăng 4', 'Phòng 01', '19:30')">
                        <i class="bi bi-ticket-perforated-fill me-2"></i> MUA VÉ NGAY
                    </button>
                    <button type="button" class="btn btn-cinema-outline btn-lg px-4 fs-6" onclick="startBookingFlow('Kẻ Trộm Mặt Trăng 4', 'Phòng 01', '19:30')">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> XEM SƠ ĐỒ GHẾ
                    </button>
                </div>

                <!-- Lời nhắc quyền lợi hội viên cho khách vãng lai -->
                <div class="mt-4 small text-secondary" id="preLoginRewardTip">
                    <i class="bi bi-stars text-warning me-1"></i> Khách hàng đăng ký hội viên miễn phí để nhận <strong>ưu đãi tích lũy 5% - 10% điểm</strong> cho mỗi đơn vé!
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================================== -->
<!-- QUICK BOOKING BAR (THANH ĐẶT VÉ NHANH ĐA BƯỚC) -->
<!-- ======================================================================== -->
<div class="container-xl quick-booking-container">
    <div class="quick-booking-card">
        <div class="row g-3 align-items-end">
            <!-- 1. Chọn Phim -->
            <div class="col-lg-3 col-md-6">
                <label class="quick-select-label"><i class="bi bi-film text-danger"></i> 1. Chọn Phim</label>
                <select class="form-select quick-select-input" id="quickSelectMovie">
                    <option value="Kẻ Trộm Mặt Trăng 4" selected>Kẻ Trộm Mặt Trăng 4 (C13)</option>
                    <option value="Dune: Hành Tinh Cát 2">Dune: Hành Tinh Cát 2 (C16)</option>
                    <option value="Kung Fu Panda 4">Kung Fu Panda 4 (P)</option>
                    <option value="Mai">Mai - Trấn Thành (C18)</option>
                    <option value="Godzilla x Kong">Godzilla x Kong: Đế Chế Mới (C13)</option>
                    <option value="Exhuma">Exhuma: Quật Mộ Trùng Ma (C18)</option>
                </select>
            </div>

            <!-- 2. Chọn Ngày Chiếu -->
            <div class="col-lg-3 col-md-6">
                <label class="quick-select-label"><i class="bi bi-calendar-event text-primary"></i> 2. Chọn Ngày Chiếu</label>
                <select class="form-select quick-select-input" id="quickSelectDate">
                    <option value="Hôm nay" selected>Hôm nay (24/11/2026)</option>
                    <option value="Ngày mai">Ngày mai (25/11/2026)</option>
                    <option value="Thứ Tư">Thứ Tư (26/11/2026)</option>
                    <option value="Thứ Năm">Thứ Năm (27/11/2026)</option>
                </select>
            </div>

            <!-- 3. Suất Chiếu & Phòng -->
            <div class="col-lg-3 col-md-6">
                <label class="quick-select-label"><i class="bi bi-clock-history text-warning"></i> 3. Suất Chiếu & Phòng</label>
                <select class="form-select quick-select-input" id="quickSelectShowtime">
                    <option value="19:30 - P01">19:30 (Phòng 01 - Còn 82 ghế)</option>
                    <option value="20:00 - P03">20:00 (Phòng 03 - Còn 34 ghế)</option>
                    <option value="20:15 - P04">20:15 (Phòng 04 - Còn 58 ghế)</option>
                    <option value="21:45 - P01">21:45 (Phòng 01 - Còn 110 ghế)</option>
                </select>
            </div>

            <!-- 4. Nút Hành Động -->
            <div class="col-lg-3 col-md-6">
                <button type="button" class="btn btn-cinema-danger w-100 py-2 fw-bold" onclick="onQuickBookingSubmit()">
                    <i class="bi bi-arrow-right-circle-fill me-1"></i> ĐẶT VÉ / CHỌN GHẾ
                </button>
            </div>
        </div>
    </div>
</div>

