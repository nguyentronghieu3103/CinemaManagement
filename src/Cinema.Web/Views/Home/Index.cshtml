<!-- BẢNG GIÁ VÉ & QUY ĐỊNH RẠP (PRICING & REGULATIONS) -->
<!-- ======================================================================== -->
<section class="py-5" id="pricingSection" style="background: #0f172a; border-top: 1px solid var(--cinema-border);">
    <div class="container-xl">
        <div class="text-center mb-5">
            <span class="badge bg-primary text-uppercase px-3 py-1 mb-2">MINH BẠCH & HỢP LÝ</span>
            <h3 class="text-white fw-bold">BẢNG GIÁ VÉ & QUY ĐỊNH PHÂN LOẠI ĐỘ TUỔI</h3>
            <p class="text-secondary small">Áp dụng tại cụm rạp Storyline Cinema 123 Điện Biên Phủ, TP.HCM</p>
        </div>

        <div class="row g-4">
            <!-- Bảng giá vé 2D Standard -->
            <div class="col-lg-4 col-md-6">
                <div class="p-4 rounded-3 h-100" style="background: var(--cinema-card); border: 1px solid var(--cinema-border);">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0">Vé 2D Chuẩn</h5>
                        <span class="badge bg-secondary">Laser 4K</span>
                    </div>
                    <ul class="list-unstyled mb-4 small">
                        <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span>Ghế Thường (Standard):</span>
                            <strong class="text-white">85.000 VNĐ</strong>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span>Ghế VIP (Prime Center):</span>
                            <strong class="text-primary">105.000 VNĐ</strong>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span>Ghế Đôi Sweetbox (2 Người):</span>
                            <strong class="text-danger">220.000 VNĐ</strong>
                        </li>
                        <li class="d-flex justify-content-between py-2">
                            <span>Học sinh / Sinh viên (U22):</span>
                            <strong class="text-success">65.000 VNĐ</strong>
                        </li>
                    </ul>
                    <div class="small text-secondary">• Phụ thu 10.000đ/vé vào Thứ 7, Chủ Nhật và ngày lễ.</div>
                </div>
            </div>

            <!-- Bảng giá vé 3D & IMAX VIP -->
            <div class="col-lg-4 col-md-6">
                <div class="p-4 rounded-3 h-100 position-relative" style="background: var(--cinema-card); border: 2px solid var(--cinema-primary);">
                    <span class="position-absolute top-0 end-0 translate-middle badge bg-primary">TRẢI NGHIỆM ĐỈNH CAO</span>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0">Vé 3D / IMAX Laser</h5>
                        <span class="badge bg-warning text-dark fw-bold">Atmos 7.1</span>
                    </div>
                    <ul class="list-unstyled mb-4 small">
                        <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span>Ghế Thường 3D:</span>
                            <strong class="text-white">120.000 VNĐ</strong>
                        </li>
