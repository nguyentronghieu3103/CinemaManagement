@section Scripts {
<script>
    // ==========================================================================
    // FRONTEND APPLICATION STATE (DEMO STATE MANAGEMENT)
    // ==========================================================================
    let isUserLoggedIn = false;
    let currentUser = {
        name: "Nguyễn Văn An",
        role: "Gold Member",
        points: 250
    };

    // Booking Flow State
    let currentBooking = {
        movie: "Kẻ Trộm Mặt Trăng 4",
        room: "Phòng 01",
        showtime: "19:30",
        step: 1,
        selectedSeats: ["F06", "F07"], // Ghế mặc định mẫu
        concessions: {
            solo: 0,
            couple: 1,
            family: 0
        },
        usePoints: false
    };

    // Khởi tạo trang
    document.addEventListener("DOMContentLoaded", function () {
        renderSeatMatrix();
        updateSelectedSeatsSummary();

        // Nút toggle demo role
        document.getElementById("btnToggleDemoRole").addEventListener("click", function () {
            toggleDemoAuthState();
        });

        // Nút đăng xuất
        document.getElementById("btnLogoutUser").addEventListener("click", function () {
            setAuthState(false);
        });
    });

    // ==========================================================================
    // CHUYỂN ĐỔI GIỮA GIAO DIỆN TRƯỚC ĐĂNG NHẬP & SAU ĐĂNG NHẬP
    // ==========================================================================
    function toggleDemoAuthState() {
        setAuthState(!isUserLoggedIn);
    }

    function setAuthState(loggedIn, name, role, points) {
        isUserLoggedIn = loggedIn;
        if (name) currentUser.name = name;
        if (role) currentUser.role = role;
        if (points) currentUser.points = points;

        const preArea = document.getElementById("preLoginAuthArea");
        const postArea = document.getElementById("postLoginAuthArea");
        const memberBanner = document.getElementById("postLoginMemberBanner");
        const demoText = document.getElementById("demoRoleText");

        if (isUserLoggedIn) {
            preArea.classList.add("d-none");
            postArea.classList.remove("d-none");
            memberBanner.classList.remove("d-none");
            demoText.innerHTML = '<span class="text-warning">● Hội Viên Đã Đăng Nhập</span>';
        } else {
            preArea.classList.remove("d-none");
            postArea.classList.add("d-none");
            memberBanner.classList.add("d-none");
            demoText.innerHTML = 'Demo: Khách Vãng Lai';
        }
    }

    function doDemoLogin(name, role, points) {
        setAuthState(true, name, role, points);
        const loginModalEl = document.getElementById("loginModal");
        const regModalEl = document.getElementById("registerModal");
        
        bootstrap.Modal.getInstance(loginModalEl)?.hide();
        bootstrap.Modal.getInstance(regModalEl)?.hide();
    }

    // ==========================================================================
    // ĐIỀU HƯỚNG DANH MỤC PHIM (TABS)
    // ==========================================================================
    function switchMovieCategory(type) {
        const btnNow = document.getElementById("tabBtnNowShowing");
        const btnUp = document.getElementById("tabBtnUpcoming");
        const gridNow = document.getElementById("gridNowShowing");
        const gridUp = document.getElementById("gridUpcoming");

        if (type === 'now') {
            btnNow.classList.add("active");
            btnUp.classList.remove("active");
            gridNow.classList.remove("d-none");
            gridUp.classList.add("d-none");
        } else {
            btnNow.classList.remove("active");
            btnUp.classList.add("active");
            gridNow.classList.add("d-none");
            gridUp.classList.remove("d-none");
        }
    }

    // ==========================================================================
    // QUY TRÌNH ĐẶT VÉ TRỰC TUYẾN 4 BƯỚC
    // ==========================================================================
    function startBookingFlow(movie, room, showtime) {
        currentBooking.movie = movie;
        currentBooking.room = room;
        currentBooking.showtime = showtime;
        currentBooking.step = 1;

        document.getElementById("bookingMovieTitle").innerText = movie;
        document.getElementById("bookingShowtimeInfo").innerText = `${room} - Laser 4K | Suất chiếu: ${showtime} (Hôm nay)`;
        
        showBookingStep(1);
        const modal = new bootstrap.Modal(document.getElementById("bookingModal"));
        modal.show();
    }

    function onQuickBookingSubmit() {
        const movie = document.getElementById("quickSelectMovie").value;
        const showtime = document.getElementById("quickSelectShowtime").value;
        startBookingFlow(movie, "Phòng 01", showtime.split(' ')[0]);
    }

    function showBookingStep(step) {
        currentBooking.step = step;

        document.getElementById("bookingStep1").classList.toggle("d-none", step !== 1);
        document.getElementById("bookingStep2").classList.toggle("d-none", step !== 2);
        document.getElementById("bookingStep3").classList.toggle("d-none", step !== 3);
        document.getElementById("bookingStep4").classList.toggle("d-none", step !== 4);

        // Update Wizard Badges
        for (let i = 1; i <= 4; i++) {
            const badge = document.getElementById(`stepBadge${i}`);
            if (i === step) {
                badge.className = "badge bg-primary text-white px-3 py-2";
            } else if (i < step) {
                badge.className = "badge bg-success text-white px-3 py-2";
            } else {
                badge.className = "badge bg-dark text-secondary border border-secondary px-3 py-2";
            }
        }

        // Footer Buttons
        const btnBack = document.getElementById("btnBookingBack");
        const btnNext = document.getElementById("btnBookingNext");

        btnBack.style.display = (step > 1 && step < 4) ? "block" : "none";

        if (step === 1) {
            btnNext.style.display = "block";
            btnNext.innerHTML = 'Tiếp Tục (Bắp Nước) <i class="bi bi-arrow-right ms-1"></i>';
            btnNext.className = "btn btn-cinema-danger";
        } else if (step === 2) {
            btnNext.style.display = "block";
            btnNext.innerHTML = 'Thanh Toán VietQR <i class="bi bi-arrow-right ms-1"></i>';
            btnNext.className = "btn btn-cinema-danger";
        } else if (step === 3) {
            btnNext.style.display = "block";
            btnNext.innerHTML = '✔ Xác Nhận Đã Chuyển Khoản';
            btnNext.className = "btn btn-success fw-bold";
            updatePaymentSummary();
        } else if (step === 4) {
            btnNext.style.display = "none";
            updateFinalTicketData();
        }
    }

    function onBookingNextStep() {
        if (currentBooking.step === 1) {
            if (currentBooking.selectedSeats.length === 0) {
                alert("Vui lòng chọn ít nhất 1 ghế trên sơ đồ trước khi tiếp tục!");
                return;
            }
            showBookingStep(2);
        } else if (currentBooking.step === 2) {
            showBookingStep(3);
        } else if (currentBooking.step === 3) {
            // Xác nhận chuyển khoản -> Sang E-Ticket
            showBookingStep(4);
        }
    }

    function onBookingPrevStep() {
        if (currentBooking.step > 1) {
            showBookingStep(currentBooking.step - 1);
        }
    }

    // ==========================================================================
    // VẼ SƠ ĐỒ GHẾ VÀ XỬ LÝ CHỌN GHẾ
    // ==========================================================================
    function renderSeatMatrix() {
        const holder = document.getElementById("seatMatrixHolder");
        if (!holder) return;
        holder.innerHTML = "";

        const rows = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
        const soldSeats = ["A01", "A02", "B03", "C10", "D05", "D06", "E08", "E09"];

        rows.forEach(r => {
            const rowDiv = document.createElement("div");
            rowDiv.className = "seat-row";

            const lbl = document.createElement("div");
            lbl.className = "seat-row-label";
            lbl.innerText = r;
            rowDiv.appendChild(lbl);

            if (r === 'H') {
                // Hàng H là 7 ghế đôi Sweetbox (H01-02, H03-04...)
                for (let c = 1; c <= 7; c++) {
                    const code = `H0${c}`;
                    const seat = document.createElement("div");
                    seat.className = "seat-item seat-sweetbox";
                    seat.innerText = code;
                    seat.dataset.code = code;
                    seat.dataset.price = "220000";

                    if (currentBooking.selectedSeats.includes(code)) {
                        seat.classList.add("seat-selected");
                    }

                    seat.onclick = () => toggleSeatSelect(seat, code);
                    rowDiv.appendChild(seat);
                }
            } else {
                // Hàng A -> G: 14 ghế mỗi hàng
                for (let c = 1; c <= 14; c++) {
                    const colNum = c < 10 ? `0${c}` : `${c}`;
                    const code = `${r}${colNum}`;
                    const seat = document.createElement("div");

                    // Ghế VIP là hàng E, F, G cột 4 đến 11
                    const isVip = (r === 'E' || r === 'F' || r === 'G') && (c >= 4 && c <= 11);
                    seat.className = isVip ? "seat-item seat-vip" : "seat-item seat-standard";
                    seat.dataset.price = isVip ? "105000" : "85000";
                    seat.innerText = colNum;
                    seat.dataset.code = code;

                    if (soldSeats.includes(code)) {
                        seat.className = "seat-item seat-sold";
                        seat.innerText = "✕";
                        seat.title = "Ghế đã có người mua";
                    } else {
                        if (currentBooking.selectedSeats.includes(code)) {
                            seat.classList.add("seat-selected");
                        }
                        seat.onclick = () => toggleSeatSelect(seat, code);
                    }

                    rowDiv.appendChild(seat);

                    // Khoảng hở lối đi giữa cột 7 và 8
                    if (c === 7) {
                        const aisle = document.createElement("div");
                        aisle.style.width = "18px";
                        rowDiv.appendChild(aisle);
                    }
                }
            }

            holder.appendChild(rowDiv);
        });
    }

    function toggleSeatSelect(el, code) {
        if (currentBooking.selectedSeats.includes(code)) {
            currentBooking.selectedSeats = currentBooking.selectedSeats.filter(s => s !== code);
            el.classList.remove("seat-selected");
        } else {
            currentBooking.selectedSeats.push(code);
            el.classList.add("seat-selected");
        }
        updateSelectedSeatsSummary();
    }

    function updateSelectedSeatsSummary() {
        const display = document.getElementById("lblSelectedSeatsDisplay");
        const priceDisplay = document.getElementById("lblSeatTotalPriceDisplay");
        if (!display || !priceDisplay) return;

        if (currentBooking.selectedSeats.length === 0) {
            display.innerText = "Chưa chọn ghế nào";
            priceDisplay.innerText = "0 VNĐ";
            return;
        }

        display.innerText = currentBooking.selectedSeats.join(", ");
        
        let total = 0;
        currentBooking.selectedSeats.forEach(code => {
            if (code.startsWith('H')) total += 220000;
            else if (['E', 'F', 'G'].includes(code[0]) && parseInt(code.substring(1)) >= 4 && parseInt(code.substring(1)) <= 11) total += 105000;
            else total += 85000;
        });

        priceDisplay.innerText = total.toLocaleString("vi-VN") + " VNĐ";
    }

    // ==========================================================================
    // BẮP NƯỚC & THANH TOÁN
    // ==========================================================================
    function changeConcessionQty(type, delta) {
        currentBooking.concessions[type] = Math.max(0, currentBooking.concessions[type] + delta);
        if (type === 'solo') document.getElementById("qtyConcessionSolo").innerText = currentBooking.concessions.solo;
        if (type === 'couple') document.getElementById("qtyConcessionCouple").innerText = currentBooking.concessions.couple;
        if (type === 'family') document.getElementById("qtyConcessionFamily").innerText = currentBooking.concessions.family;
    }

    function toggleLoyaltyDiscount() {
        currentBooking.usePoints = document.getElementById("chkUseLoyaltyPoints").checked;
        updatePaymentSummary();
    }

    function updatePaymentSummary() {
        document.getElementById("summaryMovieName").innerText = currentBooking.movie;
        document.getElementById("summarySeats").innerText = currentBooking.selectedSeats.join(", ");

        let ticketTotal = 0;
        currentBooking.selectedSeats.forEach(code => {
            if (code.startsWith('H')) ticketTotal += 220000;
            else if (['E', 'F', 'G'].includes(code[0]) && parseInt(code.substring(1)) >= 4 && parseInt(code.substring(1)) <= 11) ticketTotal += 105000;
            else total = 85000;
        });

        let concessionTotal = (currentBooking.concessions.solo * 85000) + 
                              (currentBooking.concessions.couple * 110000) + 
                              (currentBooking.concessions.family * 165000);

        let discount = currentBooking.usePoints ? 40000 : 0;
        let finalAmount = ticketTotal + concessionTotal - discount;

        document.getElementById("summaryTicketPrice").innerText = ticketTotal.toLocaleString("vi-VN") + " VNĐ";
        document.getElementById("summaryConcessionPrice").innerText = concessionTotal.toLocaleString("vi-VN") + " VNĐ";
        document.getElementById("summaryFinalAmount").innerText = finalAmount.toLocaleString("vi-VN") + " VNĐ";
        document.getElementById("qrAmountDisplay").innerText = finalAmount.toLocaleString("vi-VN") + " VNĐ";
    }

    function updateFinalTicketData() {
        document.getElementById("eticketMovie").innerText = currentBooking.movie;
        document.getElementById("eticketShowtime").innerText = `${currentBooking.showtime} - Hôm nay`;
        document.getElementById("eticketSeats").innerText = currentBooking.selectedSeats.join(", ");
    }

    // ==========================================================================
    // DASHBOARD & MODAL TIỆN ÍCH
    // ==========================================================================
    function openCustomerDashboard(tab) {
        setAuthState(true); // Đảm bảo trạng thái đã login
        const modal = new bootstrap.Modal(document.getElementById("customerDashboardModal"));
        modal.show();
    }

    function showTicketDetailModal(barcode) {
        startBookingFlow("Kẻ Trộm Mặt Trăng 4", "Phòng 01", "19:30");
        showBookingStep(4);
    }

    function openTrailerModal(movieTitle) {
        document.getElementById("trailerModalTitle").innerText = `Trailer HD: ${movieTitle}`;
        const modal = new bootstrap.Modal(document.getElementById("trailerModal"));
        modal.show();
    }

    function performTicketLookup() {
        const val = document.getElementById("txtLookupBarcode").value.trim();
        if (!val) {
            alert("Vui lòng nhập mã vé hoặc số điện thoại!");
            return;
        }
        showTicketDetailModal(val);
    }
</script>
